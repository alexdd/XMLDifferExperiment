{
  "name": "nodejs-xmldiff",
  "version": "1.0.0",
  "description": "ID-based XML diffing with SaxonJS (port of repository XSLT algorithm)",
  "main": "src/diffEngine.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:scenarios",
    "test:unit": "node --test test/unit/**/*.test.js",
    "test:scenarios": "node test/run-scenarios.js",
    "test:level": "node test/run-scenarios.js",
    "test:out-of-scope": "node test/run-scenarios.js --out-of-scope",
    "generate:s1000d": "node scripts/generate-s1000d-scenarios.js",
    "generate:dita": "node scripts/generate-dita-scenarios.js",
    "generate:fixtures": "npm run generate:s1000d && npm run generate:dita",
    "compile": "npx xslt3 -xsl:xslt/diff.xsl -export:sef/diff.sef.json -nogo && npx xslt3 -xsl:xslt/roundtrip.xsl -export:sef/roundtrip.sef.json -nogo"
  },
  "keywords": [
    "xml",
    "diff",
    "xslt",
    "saxon-js"
  ],
  "license": "LGPL-3.0-or-later",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "diff": "^9.0.0",
    "saxon-js": "^2.7.0",
    "xpath": "^0.0.34",
    "xslt3": "^2.7.0"
  }
}
