<?xml version="1.0" encoding="UTF-8"?>
<content id="uid-0001">
<description id="uid-0002">
<levelledPara id="uid-0003">
<title id="uid-0004">Physical description of a bicycle</title>
<para id="uid-0005">A bicycle (refer to <internalRef xmlns:xlink="http://www.w3.org/1999/xlink" xlink:actuate="onRequest" xlink:show="replace" xlink:href="#fig-0001" internalRefId="fig-0001" internalRefTargetType="irtt01" id="uid-0006"/>) is a frame and a number of movable components with mechanical parts that are completely open. There are no covers or sheet metal panels that prevent access to the mechanical parts. Thus, you can disassemble the different components of a bicycle (refer to <internalRef xmlns:xlink="http://www.w3.org/1999/xlink" xlink:actuate="onRequest" xlink:show="replace" xlink:href="#fig-0001-gra-0001-hot-0000" internalRefId="fig-0001-gra-0001-hot-0000" internalRefTargetType="irtt11" id="uid-0007"/>) to do: <randomList listItemPrefix="pf02" id="uid-0008">
<listItem id="uid-0009">
<para id="uid-0010">an inspection</para>
</listItem>
<listItem id="uid-0011">
<para id="uid-0012">a maintenance task</para>
</listItem>
<listItem id="uid-0013">
<para id="uid-0014">a repair task</para>
</listItem>
</randomList>
</para>
<figure id="fig-0001">
<title id="uid-0015">Complete bicycle</title>
<graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:type="simple" xlink:actuate="onRequest" xlink:show="new" xlink:href="URN:S1000D:ICN-S1000DBIKE-AAA-D000000-0-U8025-00536-A-04-1" xlink:title="Complete bicycle" infoEntityIdent="ICN-S1000DBIKE-AAA-D000000-0-U8025-00536-A-04-1" id="uid-0016">
